#: ../../_static/plots/C5_virtual_battery_weight_and_allocation.py:18
#: ../../_static/plots/C5_virtual_battery_weight_and_allocation.py:28
msgid ""
"Virtual battery weight evolution and capacity allocation showing adaptive"
