stateDiagram-v2
   [*] --> Initialize
   Initialize --> MainLoop : GPIO setup complete
   state MainLoop {
      ReadButtons --> CheckButtonPress : Scan all pins
      CheckButtonPress --> ExecuteCallback : Button pressed
      CheckButtonPress --> UpdateLEDs : No press detected
      ExecuteCallback --> UpdateLEDs : Action completed
      UpdateLEDs --> SyncWithSimulation : Query device states
      SyncWithSimulation --> ReadButtons : Wait 100ms delay
   }
